{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FLIM_API_BASE_URL": "https://www.flim.ca"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_FLIM_API_BASE_URL": "https://www.flim.ca"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FLIM_API_BASE_URL": "https://www.flim.ca"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
